---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Socials from '../components/Socials.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, galleries, posts, url, fullUrl } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
  mode?: 'home' | 'contact' | 'page';
  section?: 'home' | 'gallery' | 'blog' | 'contact';
  current?: string;       // 当前相册/文章 slug，用于高亮子菜单
  prev?: { href: string; label: string } | null;
  next?: { href: string; label: string } | null;
  ogImage?: string;
}
const { title, description = '', mode = 'page', section, current, prev = null, next = null, ogImage } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const lang = site.language ?? 'zh-CN';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={fullUrl(ogImage)} />}
    <meta name="theme-color" content="#ff6347" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  </head>
  <body class={`is-${mode}`}>
    <button class="nav-toggle" aria-label="菜单" aria-expanded="false" data-nav-toggle>
      <span class="i-menu"><Icon name="menu" size={30} /></span><span class="i-close"><Icon name="close" size={28} /></span>
    </button>
    <aside class="mobile-menu" aria-label="手机菜单">
      <ul>
        <li class:list={[section === 'home' && 'active']}><a href={url()}>Home</a></li>
        <li class:list={['has-sub', section === 'gallery' && 'open']}>
          <a href={url('gallery/')} data-acc>Gallery</a>
          <ul class="msub">{galleries.map((g) => <li class:list={[current === g.slug && section === 'gallery' && 'current']}><a href={url(`gallery/${g.slug}/`)}>{g.title}</a></li>)}</ul>
        </li>
        <li class:list={['has-sub', section === 'blog' && 'open']}>
          <a href={url('blog/')} data-acc>Blog</a>
          <ul class="msub">{posts.map((p) => <li class:list={[current === p.slug && section === 'blog' && 'current']}><a href={url(`blog/${p.slug}/`)}>{p.title}</a></li>)}</ul>
        </li>
        <li class:list={[section === 'contact' && 'active']}><a href={url('contact/')}>Contact</a></li>
      </ul>
    </aside>
    <div class="site-wrap">
    <header class="site-header">
      <a class="logo" href={url()}>{site.title}</a>
      <div class="nav-wrap">
        <nav class="main-nav" aria-label="主菜单">
          <ul>
            <li class:list={[section === 'home' && 'active']}><a href={url()}>Home</a></li>
            <li class:list={['has-sub', section === 'gallery' && 'active']}>
              <a href={url('gallery/')} data-parent>Gallery</a>
              <ul class="sub">
                {galleries.map((g) => (
                  <li class:list={[current === g.slug && section === 'gallery' && 'current']}><a href={url(`gallery/${g.slug}/`)}>{g.title}</a></li>
                ))}
              </ul>
            </li>
            <li class:list={['has-sub', section === 'blog' && 'active']}>
              <a href={url('blog/')} data-parent>Blog</a>
              <ul class="sub">
                {posts.map((p) => (
                  <li class:list={[current === p.slug && section === 'blog' && 'current']}><a href={url(`blog/${p.slug}/`)}>{p.title}</a></li>
                ))}
              </ul>
            </li>
            <li class:list={['has-sub', section === 'contact' && 'active']}>
              <a href={url('contact/')} data-parent>Contact</a>
              <div class="sub sub-contact">
                <ContactForm id="nav" />
                <Socials />
              </div>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <slot />

    {prev && <a class="side-btn prev" href={prev.href} aria-label={prev.label} title={prev.label}><Icon name="left" size={22} /></a>}
    {next && <a class="side-btn next" href={next.href} aria-label={next.label} title={next.label}><Icon name="right" size={22} /></a>}
    {mode !== 'home' && <button class="float-btn top" aria-label="回到顶部" data-top><Icon name="up" size={22} /></button>}

    <footer class="site-footer">
      <button class="to-top" aria-label="回到顶部" data-top><Icon name="up" size={20} /></button>
      <Socials />
      <p>© {new Date().getFullYear()} {site.title}</p>
    </footer>
    </div>
    <div class="toast" data-toast></div>

    <script>
      const body = document.body;
      // 手机菜单：页面向左滑出，露出右侧菜单
      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
      const wrap = document.querySelector<HTMLElement>('.site-wrap')!;
      const setNav = (open: boolean) => {
        body.classList.toggle('nav-open', open);
        toggle.setAttribute('aria-expanded', String(open));
      };
      toggle.addEventListener('click', () => setNav(!body.classList.contains('nav-open')));
      // 菜单打开时，点击左侧露出的页面 = 关闭菜单（不触发页面内的链接）
      wrap.addEventListener('click', (e) => {
        if (body.classList.contains('nav-open')) { e.preventDefault(); e.stopPropagation(); setNav(false); }
      }, true);
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setNav(false); });
      window.matchMedia('(min-width: 900px)').addEventListener('change', (m) => { if (m.matches) setNav(false); });
      // Gallery / Blog 点一下展开，再点收起（+ / −）
      document.querySelectorAll<HTMLAnchorElement>('.mobile-menu [data-acc]').forEach((a) => {
        a.addEventListener('click', (e) => {
          e.preventDefault();
          const li = a.parentElement!;
          const willOpen = !li.classList.contains('open');
          document.querySelectorAll('.mobile-menu .has-sub.open').forEach((x) => x.classList.remove('open'));
          if (willOpen) li.classList.add('open');
        });
      });
      // 回到顶部
      const tops = document.querySelectorAll<HTMLElement>('[data-top]');
      tops.forEach((b) => b.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' })));
      const topBtn = document.querySelector<HTMLElement>('.float-btn.top');
      const onScroll = () => topBtn?.classList.toggle('show', window.scrollY > 500);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      // 提示条
      const toast = document.querySelector<HTMLElement>('[data-toast]')!;
      let tt: number;
      (window as any).toast = (msg: string) => {
        toast.textContent = msg; toast.classList.add('show');
        clearTimeout(tt); tt = window.setTimeout(() => toast.classList.remove('show'), 2200);
      };
      // 联系表单
      const started = Date.now();
      document.querySelectorAll<HTMLFormElement>('form[data-contact]').forEach((form) => {
        const status = form.querySelector<HTMLElement>('.form-status')!;
        const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          status.className = 'form-status';
          if (!form.checkValidity()) { status.textContent = '请填写姓名、有效邮箱和内容'; status.classList.add('err'); form.reportValidity(); return; }
          (form.elements.namedItem('t') as HTMLInputElement).value = String(Date.now() - started);
          btn.disabled = true; status.textContent = '发送中…';
          try {
            const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
            const json = await res.json().catch(() => ({}));
            if (res.ok && json.ok) { status.textContent = '已发送，谢谢！'; status.classList.add('ok'); form.reset(); }
            else { status.textContent = json.error || '发送失败，请稍后再试'; status.classList.add('err'); }
          } catch { status.textContent = '网络错误，请稍后再试'; status.classList.add('err'); }
          btn.disabled = false;
        });
      });
    </script>
  </body>
</html>
