---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { home, site, url, fixHtml } from '../lib/data';
const { slides, intro } = home;
---
<Base mode="home" section="home" description={intro.html.replace(/<[^>]+>/g, '').trim()} ogImage={slides[0]?.src}>
  <section class="hero" data-hero data-interval="6000">
    {slides.map((s, i) => (
      <div class:list={['hero-slide', i === 0 && 'on']}>
        <img src={url(s.src)} width={s.w} height={s.h} alt="" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
      </div>
    ))}
    <div class="hero-bar"></div>
    <button class="hero-down" aria-label="向下" data-down><Icon name="down" size={26} /></button>
  </section>
  <section class="intro" id="intro">
    <h1>{intro.title || site.title}</h1>
    <Fragment set:html={fixHtml(intro.html)} />
  </section>

  <script>
    const hero = document.querySelector<HTMLElement>('[data-hero]')!;
    const slides = [...hero.querySelectorAll<HTMLElement>('.hero-slide')];
    const bar = hero.querySelector<HTMLElement>('.hero-bar')!;
    const interval = Number(hero.dataset.interval) || 6000;
    hero.style.setProperty('--interval', interval + 'ms');
    let i = 0;
    const runBar = () => { bar.classList.remove('run'); void bar.offsetWidth; bar.classList.add('run'); };
    const show = (n: number) => {
      slides[i].classList.remove('on'); i = (n + slides.length) % slides.length;
      const img = slides[i].querySelector('img'); if (img) img.loading = 'eager';
      slides[i].classList.add('on'); runBar();
    };
    if (slides.length > 1) {
      let timer = window.setInterval(() => show(i + 1), interval);
      document.addEventListener('visibilitychange', () => {
        clearInterval(timer);
        if (!document.hidden) { timer = window.setInterval(() => show(i + 1), interval); runBar(); }
      });
    }
    runBar();
    document.querySelector('[data-down]')?.addEventListener('click', () => document.getElementById('intro')?.scrollIntoView({ behavior: 'smooth' }));
  </script>
</Base>
