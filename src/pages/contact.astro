---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Socials from '../components/Socials.astro';
import { site, url, home } from '../lib/data';
const bg = home.slides.find((s) => s.src.includes((site.contactBackground ?? '').split('/').pop()!.replace(/\.[^.]+$/, '').toLowerCase())) ?? home.slides[home.slides.length - 1];
---
<Base title="Contact" mode="contact" section="contact" description="给我发邮件">
  <div class="contact-bg">{bg && <img src={url(bg.src)} alt="" />}</div>
  <main class="contact-stage">
    <div class="contact-card">
      <h1>Contact</h1>
      <p class="contact-intro">{site.contactIntro ?? "Hey why don't you go ahead and contact me?"}</p>
      <ContactForm id="page" placeholder="Message" />
      <Socials />
    </div>
  </main>
</Base>
